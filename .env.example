# Jagr server configuration. Copy to .env.local (git-ignored) for local development, or set these as
# server-side environment variables in your deployment (never VITE_-prefixed). No values here are real.

# ── Backend (optional: without it Jagr is browser-local only) ──
# DATABASE_URL=postgres://user:password@host:5432/jagr     # a managed Postgres
# DATABASE_SSL=require                                      # require (default) | no-verify | disable
# JAGR_DEV_DB=pglite                                        # local dev only: on-disk PGlite in .jagr/
# JAGR_APP_URL=https://your-jagr.example.com                # used for OAuth redirects and cookies
# JAGR_SESSION_SECRET=                                      # ≥32 random characters (openssl rand -hex 32)
# JAGR_SECRET_KEY=                                          # base64 of 32 random bytes (openssl rand -base64 32)
# JAGR_SECRET_KEYS=1:<old base64>,2:<new base64>            # instead of JAGR_SECRET_KEY, to rotate
# CRON_SECRET=                                              # the scheduler tick (/api/cron/tick) requires it

# ── Sign-in (at least one) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Owner-configured single-tenant mode ──
# JAGR_MODE=single-tenant
# JAGR_OWNER_IDENTITIES=google:<subject>,github:<numeric user id>
# JAGR_OWNER_WORKSPACE_NAME=Jagr
# Owner credentials. Copied at startup into encrypted storage (JAGR_SECRET_KEY); never sent to the
# browser, never exported. Changing a value rotates the stored secret; removing one disconnects it.
# JAGR_AMPLITUDE_API_KEY=
# JAGR_AMPLITUDE_SECRET_KEY=
# JAGR_AMPLITUDE_REGION=us                                  # us | eu
# JAGR_AMPLITUDE_METRICS=                                   # metric bindings (JSON, see docs/CONNECTORS.md)
# JAGR_AMPLITUDE_APP_URL=https://app.amplitude.com/analytics/<org>
# JAGR_AMPLITUDE_UTC_OFFSET_MINUTES=0                       # the project's timezone offset
# JAGR_GITHUB_TOKEN=                                        # fine-grained, read-only: deployments, releases, metadata
# JAGR_GITHUB_APP_ID=                                       # GitHub App auth: not supported yet (reported as a config error)
# JAGR_GITHUB_APP_PRIVATE_KEY=
# JAGR_GITHUB_INSTALLATION_ID=
# JAGR_GITHUB_REPOS=owner/repo,owner/other
# JAGR_GITHUB_ENVIRONMENTS=production                     # deployment environments to read
# JAGR_JIRA_SITE=https://your-site.atlassian.net
# JAGR_JIRA_EMAIL=
# JAGR_JIRA_API_TOKEN=
# JAGR_JIRA_PROJECT=KEY
# JAGR_INTERCOM_TOKEN=
# JAGR_INTERCOM_REGION=us                                   # us | eu | au
# JAGR_INTERCOM_APP_ID=                                     # workspace id, for inbox deep links
# JAGR_SLACK_BOT_TOKEN=                                     # chat:write only
# JAGR_SLACK_CHANNEL=C0123456789

# ── AI planner (unchanged) ──
# PLANNER_MODE=deterministic
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_API_KEY=
