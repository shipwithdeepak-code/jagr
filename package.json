{
  "name": "product-nightwatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.product.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.product.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:planners": "JAGR_LIVE_EVAL=1 vitest run scripts/eval/plannerComparison.live.ts --reporter=verbose --silent=false",
    "eval:connectors": "NODE_USE_ENV_PROXY=1 JAGR_LIVE_EVAL=1 vitest run scripts/eval/connectors.live.ts --reporter=verbose --silent=false",
    "eval:ui": "npm run build && JAGR_LIVE_EVAL=1 vitest run scripts/eval/serverWorkspace.ui.live.ts --reporter=verbose",
    "smoke:production": "JAGR_LIVE_EVAL=1 vitest run scripts/eval/production.smoke.live.ts --reporter=verbose --silent=false",
    "eval:qa": "npm run build && JAGR_LIVE_EVAL=1 vitest run scripts/eval/qa.ui.live.ts --reporter=verbose --silent=false",
    "eval:dogfood": "NODE_USE_ENV_PROXY=1 JAGR_LIVE_EVAL=1 vitest run scripts/eval/dogfood.live.ts --reporter=verbose --silent=false"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/config": "^1.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
